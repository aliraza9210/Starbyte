# STAR BYTE Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Connect -> Connect your application
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/starbyte?retryWrites=true&w=majority

# JWT Secrets (generate random strings)
AUTH_SECRET=starbyte_jwt_user_secret_replace_with_random_string_2026
ADMIN_SECRET=starbyte_jwt_admin_secret_replace_with_random_string_2026

# WhatsApp & Contact Defaults
WHATSAPP_NUMBER=+923327775418

# Frontend URL (your Vercel live domain)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
